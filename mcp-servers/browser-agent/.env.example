# Optional override for a compatible Windows Chromium-family browser.
# Leave unset to use the managed Stable Chrome for Testing build.
BROWSER_AGENT_WINDOWS_BROWSER_BIN=

# Optional fixed MCP-to-extension bridge settings.
# The defaults are loopback and a dynamically allocated port.
BROWSER_AGENT_BRIDGE_HOST=127.0.0.1
BROWSER_AGENT_BRIDGE_PORT=
